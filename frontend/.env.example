# Copy to `.env.local` to override defaults.

# Development adapters (no backend required). Default: true.
# Set to "false" to talk to the real PAW backend.
VITE_USE_MOCK=true

# Base URL of the REST API (POST {base}/api/analyze).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Full WebSocket URL for live analysis.
# If omitted it is derived from VITE_API_BASE_URL + /ws/posture.
VITE_WS_URL=ws://127.0.0.1:8000/ws/posture
